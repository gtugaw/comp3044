[142.445628, "o", "DATE(1)                                                           User Commands                                                          DATE(1)\u001b[m\r\n\u001b[m\r\n\u001b[1mNAME\u001b[0m\u001b[m\r\n       date - print or set the system date and time\u001b[m\r\n\u001b[m\r\n\u001b[1mSYNOPSIS\u001b[0m\u001b[m\r\n       \u001b[1mdate\u001b[0m [\u001b[4mOPTION\u001b[24m]... [\u001b[4m+FORMAT\u001b[24m]\u001b[m\r\n       \u001b[1mdate\u001b[0m [\u001b[4m-u|--utc|--universal\u001b[24m] [\u001b[4mMMDDhhmm\u001b[24m[[\u001b[4mCC\u001b[24m]\u001b[4mYY\u001b[24m][\u001b[4m.ss\u001b[24m]]\u001b[m\r\n\u001b[m\r\n\u001b[1mDESCRIPTION\u001b[0m\u001b[m\r\n       Display the current time in the given FORMAT, or set the system date.\u001b[m\r\n\u001b[m\r\n       Mandatory arguments to long options are mandatory for short options too.\u001b[m\r\n\u001b[m\r\n       \u001b[1m-d\u001b[0m, \u001b[1m--date\u001b[0m=\u001b[4mSTRING\u001b[24m\u001b[m\r\n              display time described by STRING, not 'now'\u001b[m\r\n\u001b[m\r\n       \u001b[1m--debug\u001b[0m\u001b[m\r\n              annotate the parsed date, and warn about questionable usage to stderr\u001b[m\r\n\u001b[m\r\n       \u001b[1m-f\u001b[0m, \u001b[1m--file\u001b[0m=\u001b[4mDATEFILE\u001b[24m\u001b[m\r\n              like \u001b[1m--date\u001b[0m; once for each line of DATEFILE\u001b[m\r\n\u001b[m\r\n       \u001b[1m-I[F"]
[142.445915, "o", "MT]\u001b[0m, \u001b[1m--iso-8601\u001b[0m[=\u001b[4mFMT\u001b[24m]\u001b[m\r\n              output  date/time in ISO 8601 format.  FMT='date' for date only (the default), 'hours', 'minutes', 'seconds', or 'ns' for date and\u001b[m\r\n              time to the indicated precision.  Example: 2006-08-14T02:34:56-06:00\u001b[m\r\n\u001b[m\r\n\u001b[7m Manual page date(1) line 1 (press h for help or q to quit)\u001b[27m\u001b[K"]
[143.508173, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K       \u001b[1m-R\u001b[0m, \u001b[1m--rfc-email\u001b[0m\u001b[m\r\n\u001b[7m Manual page date(1) line 2 (press h for help or q to quit)\u001b[27m\u001b[K"]
[143.708142, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              output date and time in RFC 5322 format.  Example: Mon, 14 Aug 2006 02:34:56 \u001b[1m-0600\u001b[0m\u001b[m\r\n\u001b[7m Manual page date(1) line 3 (press h for help or q to quit)\u001b[27m\u001b[K"]
[143.853194, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K\u001b[m"]
[143.853369, "o", "\r\n\u001b[7m Manual page date(1) line 4 (press h for help or q to quit)\u001b[27m\u001b[K"]
[144.003727, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K"]
[144.003987, "o", "       \u001b[1m--rfc-3339\u001b[0m=\u001b[4mFMT\u001b[24m\u001b[m\r\n\u001b[7m Manual page date(1) line 5 (press h for help or q to quit)\u001b[27m\u001b[K"]
[144.141921, "o", "\r\u001b[K \u001b[KESC\b\b\bESC\u001b[KO\bO\u001b[KB\bB\r\u001b[K              output date/time in RFC 3339 format.  FMT='date', 'seconds', or 'ns' for date and  time  to  the  indicated  precision.   Example:\u001b[m"]
[144.142124, "o", "\r\n\u001b[7m Manual page date(1) line 6 (press h for help or q to quit)\u001b[27m\u001b[K"]
