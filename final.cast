[980.285455, "o", "\u001b[2d\u001b[39;49m\u001b[36m#!/bin/bash\r\u001b[4d\u001b[39m\u001b(B\u001b[mcdate\u001b[32m=$(\u001b[39m\u001b(B\u001b[mdate +%Y-%m-%d\u001b[32m)\r\u001b[5d\u001b(B\u001b[0;1m\u001b[34mecho\u001b[39m\u001b(B\u001b[m \u001b(B\u001b[0;1m\u001b[33m\"Today is $cdate\"\r\u001b[7d\u001b(B\u001b[0m\u001b[32mif\u001b[39m\u001b(B\u001b[m \u001b[32m[\u001b(B\u001b[0;1m\u001b[35m -d\u001b[39m\u001b(B\u001b[m logfiles/log-\u001b(B\u001b[0;1m\u001b[31m$cdate\u001b[39m\u001b(B\u001b[m \u001b[32m];\u001b[39m\u001b(B\u001b[m \u001b[32mthen\u001b[8;9H\u001b[39m\u001b(B\u001b[merror \u001b(B\u001b[0;1m\u001b[33m\"error: directory already exist, please try again tomorrow\"\u001b[9;9H\u001b(B\u001b[0m\u001b[32mexit\u001b[39m\u001b(B\u001b[m 1\r\u001b[10d\u001b[32melse\u001b[11;9H\u001b(B\u001b[0;1m\u001b[34mmkdir\u001b[35m -p\u001b[39m\u001b(B\u001b[m logfiles/log-\u001b(B\u001b[0;1m\u001b[31m$cdate\u001b[12;9H\u001b[34mcp\u001b[39m\u001b(B\u001b[m /var/log/*.log logfiles/log-\u001b(B\u001b[0;1m\u001b[31m$cdate\u001b[39m\u001b(B\u001b[m 2\u001b[32m>>\u001b[39m\u001b(B\u001b[m error.txt\r\u001b[13d\u001b[32mfi\r\u001b[15dfor\u001b[39m\u001b(B\u001b[m file \u001b[32min\u001b[39m\u001b(B\u001b[m logfiles/log-\u001b(B\u001b[0;1m\u001b[31m$cdate\u001b[39m\u001b(B\u001b[m/*.log\r\u001b[16d\u001b[32mdo\u001b[17;9H\u001b(B\u001b[0;1m\u001b[34mtar\u001b[39m\u001b(B\u001b[m -czf \u001b(B\u001b[0;1m\u001b[31m$file\u001b(B\u001b[0m.tar\u001b(B\u001b[m.gz \u001b(B\u001b[0;1m\u001b[31m$file\u001b[39m\u001b(B\u001b[m 2\u001b[32m>>\u001b[39m\u001b(B\u001b[m error.txt\r\u001b[18d\u001b[32mdone\r\u001b[20d\u001b(B\u001b[0;1m\u001b[34mrm\u001b[35m -f\u001b[39m\u001b(B\u001b[m logfiles/lod-\u001b(B\u001b[0;1m\u001b[31m$cdate\u001b[39m\u001b(B\u001b[m/*.log\r\u001b[21d\u001b(B\u001b[0;1m\u001b[34mec"]
